      "compression@<1.8.2": "1.8.2",
      "decode-uri-component@<0.5.0": "0.5.0",
      "image-size": "npm:image-size-next@2.1.0",
      "js-yaml@>=3.0.0 <4.0.0": "3.15.2",
      "js-yaml@>=4.0.0 <5.0.0": "4.3.2",
      "postcss@<=8.5.27": "8.5.28",
      "shell-quote@<1.11.0": "1.11.0",
      "source-map-js@<1.2.2": "1.2.2",
      "undici@>=6.0.0 <7.0.0": "6.29.0",
      "undici@>=7.0.0 <8.0.0": "7.30.0",
      "uuid@<11.1.1": "11.1.1"
